    "test:inventory": "nx test inventory",
    "lint": "nx run-many -t lint --projects=react-store,inventory --parallel",
    "lint:store": "nx lint react-store",
    "lint:inventory": "nx lint inventory",
    "e2e:store": "nx e2e react-store-e2e",
    "e2e:inventory": "nx e2e inventory-e2e",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "private": true,
