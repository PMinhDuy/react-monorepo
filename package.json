  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve --projects=react-store,inventory --parallel",
    "dev:store": "nx serve react-store",
    "dev:inventory": "nx serve inventory",
    "build": "nx run-many -t build --projects=react-store,inventory --parallel",
    "build:store": "nx build react-store",
    "build:inventory": "nx build inventory",
    "test": "nx run-many -t test --projects=react-store,inventory --parallel",
