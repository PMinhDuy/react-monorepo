{
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build --emitDeclarationOnly",
        "cwd": "libs/shared/auth"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  }
}
