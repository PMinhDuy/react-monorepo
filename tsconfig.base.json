{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@react-monorepo/catalog": ["libs/catalog/src/index.ts"],
      "@react-monorepo/orders": ["libs/orders/src/index.ts"],
      "@react-monorepo/products": ["libs/products/src/index.ts"],
      "@react-monorepo/shared-auth": ["libs/shared/auth/src/index.ts"],
      "@react-monorepo/shared-graphql": ["libs/shared/graphql/src/index.ts"],
      "@react-monorepo/shared-ui": ["libs/shared/ui/src/index.ts"]
    }
  }
}
